167-233-84-81.sslip.io {
    # Proxy API requests to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Serve React frontend static files
    handle {
        root * /srv/www
        try_files {path} /index.html
        file_server
    }
}

# The classified-ads app is a separate compose project in /srv/classified-ads.
# It joins this stack's network (app_default) and publishes no ports, so this
# is the only thing making it reachable. The block lives here because this
# repo owns /app/Caddyfile — a deploy from here rsyncs over whatever is on the
# server, so removing this silently takes the ads site down.
ads.167-233-84-81.sslip.io {
    reverse_proxy classified-ads:3000
}
